[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4

[mysqld]
# ----------------------------------------
# 基础设置 (Basic Settings)
# ----------------------------------------
port = 3306
bind-address = 0.0.0.0

# 禁用主机名解析，提高连接速度（仅允许IP连接）
skip-name-resolve
# 设置默认时区，避免时区问题
default-time-zone = '+08:00'

# ----------------------------------------
# 连接与线程 (Connections & Threads)
# ----------------------------------------
# 最大连接数，32G内存通常 1000-2000 足够，过大容易OOM
max_connections = 1000
# 最大的连接错误次数，防止频繁报错被封IP
max_connect_errors = 100000
# 打开文件的数量限制
open_files_limit = 65535
# 线程缓存，减少线程创建销毁的开销
thread_cache_size = 100

# ----------------------------------------
# 内存分配核心参数 (Memory Allocation)
# ----------------------------------------
# 【核心】InnoDB 缓冲池大小，建议设置为物理内存的 50%-75%。
# 32GB * 70% ≈ 22GB。这是 MySQL 性能的关键。
innodb_buffer_pool_size = 22G

# 将 Buffer Pool 分为几个实例，建议 1G 一个实例，或者是核数的倍数。
# 8核 CPU 设置为 8，可以减少并发争用。
innodb_buffer_pool_instances = 8

# ----------------------------------------
# InnoDB 引擎调优 (InnoDB Tuning)
# ----------------------------------------
# 事务日志文件大小。较大的值可以提高写入性能，但崩溃恢复时间会变长。
innodb_log_file_size = 2G
# 日志缓冲区大小
innodb_log_buffer_size = 64M

# 刷盘策略：
# 1 = 最安全，每次事务提交都刷盘（ACID），不丢数据但IO高。
# 2 = 每秒刷盘，性能好，断电可能丢失1秒数据。
# 0 = 性能最好，但崩溃可能丢失1秒数据。
# 生产环境建议 1，对性能要求极高且允许丢少量数据可选 2。
innodb_flush_log_at_trx_commit = 1

# 数据刷盘方式，Linux下通常使用 O_DIRECT 避免双重缓冲
innodb_flush_method = O_DIRECT

# IO 能力设置，取决于磁盘类型。
# 如果是 SSD，建议设置 2000-5000；如果是机械硬盘，建议 200-500。
innodb_io_capacity = 200
innodb_io_capacity_max = 400

# ----------------------------------------
# 临时表与排序 (Buffers & Temp Tables)
# ----------------------------------------
# 注意：以下参数是“每个线程”独占的，设置过大会导致内存溢出 (OOM)
sort_buffer_size = 4M
join_buffer_size = 4M
read_buffer_size = 2M
read_rnd_buffer_size = 2M

# 内存临时表大小，超过此大小将写入磁盘
tmp_table_size = 128M
max_heap_table_size = 128M

# ----------------------------------------
# 日志设置 (Logging)
# ----------------------------------------
# 开启二进制日志（用于主从复制和数据恢复）
log_bin = mysql-bin
binlog_format = ROW
# 二进制日志过期时间 (7天 = 604800秒)
binlog_expire_logs_seconds = 604800
# 单个 binlog 文件最大大小
max_binlog_size = 1G

# 开启慢查询日志
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
# 超过 2 秒的查询被记录
long_query_time = 2
# 记录没有使用索引的查询
log_queries_not_using_indexes = 0

# 错误日志路径
log-error = /var/log/mysql/error.log

# ----------------------------------------
# 字符集与排序规则 (Character Set)
# ----------------------------------------
character-set-server = utf8mb4
collation-server = utf8mb4_general_ci

# ----------------------------------------
# MySQL 8.0 特性调整
# ----------------------------------------
# 也就是所谓的“双一”配置之一，保证 binlog 落盘安全性
sync_binlog = 1
# 默认验证插件，如果旧应用连接报错，可改为 mysql_native_password
default_authentication_plugin = caching_sha2_password
# 禁用符号链接，安全起见
symbolic-links = 0